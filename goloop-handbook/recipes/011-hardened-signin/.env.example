# Copy to .env. In production JWT_SECRET is mandatory and must be stable
# across restarts, or every deploy signs tokens the previous one cannot verify.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Abuse budgets. Attempts/window is the guessing brake; concurrency is memory.
AUTH_ATTEMPTS=10
AUTH_WINDOW=15m
AUTH_CONCURRENCY=32

# Argon2id memory budget: HASH_CONCURRENCY x cost-per-hash must fit the process.
# At the library default (64 MiB per hash) 4 slots is 256 MiB.
HASH_CONCURRENCY=4
